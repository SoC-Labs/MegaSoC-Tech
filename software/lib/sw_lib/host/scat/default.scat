; MBT-56 (2026-10-21): RW/ZI are now EXECUTION regions of the ROM load region, so the RW initial values get a
; load address in the flash image and __scatterload (called from __main, see stack_multi_cpu_init.s) copies them
; to SRAM and zeroes ZI at start-up. Before, RWZI was a separate SRAM load region that nothing initialised on
; silicon (only the simulation testbench preloaded it from app_ram.v8-a.hex).
ROM 0x00400000 
{
    EXEC_ROM 0x00400000 0x400000
    {
        boot.s.v8-a.o (SECURE_ROM_BOOT, +FIRST)
        *(+RO)
    }
    RWZI 0x00800000 0x4000
    {
        *(+RW,+ZI)
    }
    ARM_LIB_STACK   0x00804000 EMPTY 0x2000 
    {
    }
    ARM_LIB_HEAP    0x00806000 EMPTY 0x2000 
    {
    }
}
