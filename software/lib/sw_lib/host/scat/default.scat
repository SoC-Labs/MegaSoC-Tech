{
    EXEC_ROM 0x00400000 0x1000000
    {
        boot.s.v8-a.o (SECURE_ROM_BOOT, +FIRST)
        *(+RO)
    }

    RWZI 0x00800000 0x4000
    {
        *(+RW,+ZI)
    }
}

